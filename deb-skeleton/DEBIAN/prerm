#!/bin/sh
# Boot OS Pro — prerm — build 1.0.2 — Monday 9 November 2026
set -e

case "$1" in
    remove|purge)
        # -x matches the process NAME exactly. -f would substring-match the
        # full command line and kill this very script
        # (/var/lib/dpkg/info/bootospro.prerm) mid-removal.
        pkill -x bootospro || true
        ;;
esac

exit 0
